# Copy to .env and edit. NEVER commit .env to git.
SECRET_KEY=change-this-to-a-long-random-string
# mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# If your password has special characters (@ : / # %), URL-encode them (e.g. @ -> %40).
DATABASE_URL=mysql+pymysql://dairy_user:CHANGE_ME_strong_password@localhost:3306/dairy_app?charset=utf8mb4
# Optional: a SEPARATE database for running tests against MySQL (tests wipe it!)
# TEST_DATABASE_URL=mysql+pymysql://root:ROOTPASS@localhost:3306/dairy_app_test?charset=utf8mb4
COOKIE_SECURE=0
# Hours ahead of UTC for your business (Kenya = 3). Used for "today" and session times.
BUSINESS_UTC_OFFSET_HOURS=3
# Optional, for the daily backup command (only if mysqldump is not found automatically):
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
# Optional: back up with a more privileged account (also saves the audit triggers):
# BACKUP_DB_USER=root
# BACKUP_DB_PASSWORD=your-root-password
